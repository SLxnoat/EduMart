# ==============================================================================
# EduMart Platform - Sample Environment Configuration (.env.example)
# Copy this file to .env and fill in your actual credentials.
# ==============================================================================

# Server & Runtime Environment
NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# Database Configuration
# Set DB_DIALECT=sqlite for zero-configuration local development.
# Set DB_DIALECT=mysql for MySQL database in production/testing.
# ------------------------------------------------------------------------------
DB_DIALECT=sqlite
DB_NAME=edumart
DB_USER=edumart_user
DB_PASSWORD=your_database_password
DB_HOST=localhost
DB_PORT=3306

# ------------------------------------------------------------------------------
# JWT Authentication
# ------------------------------------------------------------------------------
JWT_SECRET=your_super_secret_jwt_key_here_change_in_production
JWT_EXPIRES_IN=24h

# ------------------------------------------------------------------------------
# REAL PAYMENT GATEWAYS CONFIGURATION
# ------------------------------------------------------------------------------

# Store Base Currency (e.g. LKR, USD)
DEFAULT_CURRENCY=LKR

# 1. Stripe Payment Gateway (Credit/Debit Cards, Apple Pay, Google Pay)
# - Create a Stripe account at https://stripe.com
# - Obtain your API Keys from: https://dashboard.stripe.com/apikeys
# - Set up a webhook endpoint pointing to: https://yourdomain.com/api/payments/webhook
#   Listening to: payment_intent.succeeded, payment_intent.payment_failed
STRIPE_SECRET_KEY=sk_test_51...your_stripe_secret_key
STRIPE_PUBLISHABLE_KEY=pk_test_51...your_stripe_publishable_key
STRIPE_WEBHOOK_SECRET=whsec_...your_stripe_webhook_secret

# 2. PayPal Gateway (PayPal Express Checkout & REST API v2)
# - Go to https://developer.paypal.com/dashboard/applications
# - Create a REST API app under 'My Apps & Credentials'
# - Set PAYPAL_MODE to 'sandbox' for testing, or 'live' for real payments
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=your_paypal_client_id_here
PAYPAL_CLIENT_SECRET=your_paypal_client_secret_here

# 3. Direct Bank Wire Transfer / Counter Deposit (Sri Lanka & International)
# Configure official corporate accounts displayed to students during checkout:
BANK_NAME_1=Commercial Bank of Ceylon PLC
BANK_ACCOUNT_NAME_1=EduMart Educational Services (Pvt) Ltd
BANK_ACCOUNT_NO_1=100023456789
BANK_BRANCH_1=Kollupitiya Branch
BANK_SWIFT_1=CCBLLKLX

BANK_NAME_2=Bank of Ceylon
BANK_ACCOUNT_NAME_2=EduMart Educational Services (Pvt) Ltd
BANK_ACCOUNT_NO_2=008920145561
BANK_BRANCH_2=Colombo Corporate Branch
BANK_SWIFT_2=BOCELKLX

# Auto-Approve Bank Transfer Slips (true = instant access; false = admin verifies)
AUTO_APPROVE_BANK_TRANSFER=false

# 4. Digital Mobile Wallets & LankaQR
# LankaQR National Standard / FriMi / eZ Cash merchant details
LANKAQR_MERCHANT_NAME=EduMart E-Learning Platform
LANKAQR_MERCHANT_ID=EDUMART-LKR-001
LANKAQR_TERMINAL_ID=TERM-01

# 5. Cash on Delivery (COD) Logistics Partner
COURIER_PARTNER_NAME=PromptX Express Courier
COURIER_HOTLINE=+94 11 234 5678

# ------------------------------------------------------------------------------
# Outbound Email Configuration (EmailJS & SMTP)
# ------------------------------------------------------------------------------
# EmailJS REST API Configuration (Primary & Recommended)
# Sign up free & obtain keys at: https://dashboard.emailjs.com
#
# Quick Setup Guide:
# 1. EMAILJS_SERVICE_ID: Dashboard -> Email Services (e.g., service_edumart or service_xxxxxxx)
# 2. EMAILJS_PUBLIC_KEY: Dashboard -> Account -> General -> Public Key
# 3. EMAILJS_PRIVATE_KEY: Dashboard -> Account -> General -> Private Key (Optional extra security)
# 4. EMAILJS_REPLY_TO: Official support mailbox for bounces/replies
# 5. Email Templates (Dashboard -> Email Templates):
#    - EMAILJS_TEMPLATE_ID: Default / custom inquiry template
#    - EMAILJS_TEMPLATE_VERIFY_ID: Account verification email template
#    - EMAILJS_TEMPLATE_RESET_ID: Password reset email template
#    - EMAILJS_TEMPLATE_ORDER_ID: Order confirmation & digital delivery receipt template
#
# Template Parameters Reference (Auto-mapped by EduMart Email Service):
# - {{to_email}} / {{user_email}} / {{email}}: Recipient email address
# - {{to_name}} / {{user_name}} / {{name}}: Recipient name
# - {{subject}}: Email subject line
# - {{message}}: Plain text message body
# - {{html_content}}: Rich HTML rendered email content
# - {{verification_url}} / {{link}}: Verification link
# - {{reset_url}} / {{link}}: Password reset link
# - {{order_number}}: Order identifier (e.g. ORD-2026-0001)
# - {{order_id}}: Order UUID
# - {{total_amount}}: Formatted total price (e.g. LKR 3,500.00)
# - {{items_summary}}: Comma-separated summary of ordered items
# - {{order_url}} / {{link}}: Order receipt link
# - {{reply_to}}: Support reply-to email
# - {{from_name}}: "EduMart Platform"
# ------------------------------------------------------------------------------
EMAILJS_SERVICE_ID=service_edumart
EMAILJS_PUBLIC_KEY=your_emailjs_public_key
EMAILJS_PRIVATE_KEY=your_emailjs_private_key
EMAILJS_TEMPLATE_ID=template_edumart
EMAILJS_TEMPLATE_VERIFY_ID=template_verify
EMAILJS_TEMPLATE_RESET_ID=template_reset
EMAILJS_TEMPLATE_ORDER_ID=template_order
EMAILJS_REPLY_TO=support@edumart.lk

# Fallback SMTP Configuration (Nodemailer / Native TLS)
# Automatically used as backup if EmailJS keys are not provided or error out.
# For Gmail:
# 1. Enable 2-Step Verification at https://myaccount.google.com/security
# 2. Generate a 16-character App Password at https://myaccount.google.com/apppasswords
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_16_character_app_password
EMAIL_FROM=EduMart <noreply@edumart.com>
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# ------------------------------------------------------------------------------
# File Upload Configuration (Study Materials, Syllabus PDFs, Avatars)
# ------------------------------------------------------------------------------
MAX_FILE_SIZE=10000000
ALLOWED_FILE_TYPES=image/jpeg,image/png,application/pdf

# ------------------------------------------------------------------------------
# Redis Cache Configuration (Optional)
# ------------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379