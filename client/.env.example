# ==============================================================================
# EduMart Client - Sample Environment Configuration (.env.example)
# ==============================================================================

# Backend API URL
REACT_APP_API_URL=http://localhost:5000/api

# Stripe Publishable Key (Safe for client-side bundle)
REACT_APP_STRIPE_PUBLISHABLE_KEY=pk_test_your_real_stripe_publishable_key_here

# PayPal Client ID (Safe for client-side script)
REACT_APP_PAYPAL_CLIENT_ID=your_real_paypal_client_id_here

# EmailJS Client-Side Configuration (Optional)
REACT_APP_EMAILJS_SERVICE_ID=service_edumart
REACT_APP_EMAILJS_TEMPLATE_ID=template_edumart
REACT_APP_EMAILJS_PUBLIC_KEY=your_emailjs_public_key
